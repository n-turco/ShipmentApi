@ShipmentApi_HostAddress = http://localhost:5109

### List all shipments
GET {{ShipmentApi_HostAddress}}/api/shipments
Accept: application/json

### Filter by status
GET {{ShipmentApi_HostAddress}}/api/shipments?status=InTransit
Accept: application/json

### Get one shipment
GET {{ShipmentApi_HostAddress}}/api/shipments/1
Accept: application/json

### Look up by tracking number
GET {{ShipmentApi_HostAddress}}/api/shipments/tracking/1Z999AA10123456784
Accept: application/json

### Create a shipment
POST {{ShipmentApi_HostAddress}}/api/shipments
Content-Type: application/json

{
  "id": 999,
  "origin": "Guelph, ON",
  "destination": "Cambridge, ON",
  "trackingNumber": "2D568DD83134567953",
  "carrier": "Fedex",
  "shippingMethod": "Ground",
  "estimatedDeliveryDate": "2026-11-15T00:00:00Z"
}

### Update a shipment
PUT {{ShipmentApi_HostAddress}}/api/shipments/1
Content-Type: application/json

{
  "origin": "Chicago, IL",
  "destination": "Denver, CO",
  "trackingNumber": "1Z999AA10123456784",
  "carrier": "UPS",
  "estimatedDeliveryDate": "2026-10-28T00:00:00Z",
  "shippingMethod": "Ground"
}

### Change status only
PATCH {{ShipmentApi_HostAddress}}/api/shipments/1/status
Content-Type: application/json

"Delivered"

### Test request rejects numeric values (return 400)
PATCH {{ShipmentApi_HostAddress}}/api/shipments/1/status
Content-Type: application/json

99

### Invalid transition: Created -> Delivered (expect 409)
PATCH {{ShipmentApi_HostAddress}}/api/shipments/2/status
Content-Type: application/json

"Delivered"

### Valid transition: Created -> Pending (expect 204)
PATCH {{ShipmentApi_HostAddress}}/api/shipments/2/status
Content-Type: application/json

"Pending"

### Same status: Pending -> Pending (expect 204, UpdatedAt unchanged)
PATCH {{ShipmentApi_HostAddress}}/api/shipments/2/status
Content-Type: application/json

"Pending"

### Going backwards: Pending -> Created (expect 409)
PATCH {{ShipmentApi_HostAddress}}/api/shipments/2/status
Content-Type: application/json

"Created"

### Delete a shipment
DELETE {{ShipmentApi_HostAddress}}/api/shipments/5

### Validation: missing origin, bad tracking number
POST {{ShipmentApi_HostAddress}}/api/shipments
Content-Type: application/json

{
  "origin": "",
  "destination": "Cambridge, ON",
  "trackingNumber": "ABC 123!"
}

### Validation: same origin and destination
POST {{ShipmentApi_HostAddress}}/api/shipments
Content-Type: application/json

{
  "origin": "Guelph, ON",
  "destination": "guelph, on ",
  "trackingNumber": "VALTEST0001"
}

### Validation: delivery date in the past
POST {{ShipmentApi_HostAddress}}/api/shipments
Content-Type: application/json

{
  "origin": "Guelph, ON",
  "destination": "Cambridge, ON",
  "trackingNumber": "VALTEST0002",
  "estimatedDeliveryDate": "2020-01-01T00:00:00Z"
}